{
  "tasks": {
    "build-engine": "deno run -A ./build-worker/build-engine.ts",
    "start-server": "deno run -c ./engine-out/deno.runtime.json -A ./server-host/main.ts",
    "start": "deno task build-engine && deno task start-server"
  },
  "imports": {
    "@dreamlab/engine": "../engine/mod.ts",
    "@dreamlab/engine/internal": "../engine/internal.ts",
    "@dreamlab/vendor/": "../engine/_deps/",
    "@dreamlab/proto/": "../proto/",
    "@dreamlab/scene": "../scene-graph/mod.ts",
    "@dreamlab/ui": "../ui/mod.ts",
    "@dreamlab/util/": "../util/"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom"
    ],
    "useUnknownInCatchVariables": false
  }
}
